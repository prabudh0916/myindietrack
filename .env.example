# =====================================================================
# IndieTrack Music Release & Promotion Analytics Platform
# Configuration Template (.env.example)
# IMPORTANT: Never commit your real .env file or real secrets to Git!
# =====================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars

# Application Base URL (used for redirects and links)
APP_BASE_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# For Local Development (Default fallback if Azure SQL is not provided):
# sqlite:///indietrack_dev.db
#
# For Azure SQL Database (Production / Azure App Service):
# Format: mssql+pyodbc://<username>:<password>@<server-name>.database.windows.net:1433/<database-name>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30
DATABASE_URL=sqlite:///indietrack_dev.db

# Optional separate Azure SQL Server connection parameters (can be assembled by config):
AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
AZURE_SQL_DATABASE=indietrack-db
AZURE_SQL_USER=indietrack-admin
AZURE_SQL_PASSWORD=replace-with-strong-db-password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------
# Azure Blob Storage Configuration
# ---------------------------------------------------------------------
# Connection string from Azure Portal -> Storage account -> Access keys
# Leave empty or set to LOCAL_DEV to use safe local folder storage in development
AZURE_STORAGE_CONNECTION_STRING=replace-with-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=indietrack-assets

# Local development storage directory (used only when Azure Storage is not configured)
LOCAL_UPLOAD_FOLDER=uploads

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=24
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_AUTH=5 per minute

# Optional Power BI Embedded / Report URL (leave blank if not configured)
POWER_BI_REPORT_URL=
